# Control case for mqttshape:TopicNameNoWildcards, reached through the response
# topic. [MQTT-3.3.2-14]: "The Response Topic MUST NOT contain wildcard
# characters."

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix MQTT: <http://www.w3id.org/hsu-aut/MQTT#> .
@prefix ex:   <http://example.org/mqtt-fixture-invalid-response-topic#> .

ex:Message_BadResponse rdf:type MQTT:ApplicationMessage ;
    MQTT:hasResponseTopic ex:Topic_BadResponse .

ex:Topic_BadResponse rdf:type MQTT:Topic ;
    MQTT:topicName "amr-1/skills/drive/result/#" .
