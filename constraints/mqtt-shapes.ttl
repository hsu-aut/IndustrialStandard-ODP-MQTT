# SHACL shapes for the MQTT ontology design pattern
# ==================================================
#
# Four statements of MQTT Version 5.0 are normative and mechanically checkable,
# yet they cannot be expressed in OWL 2: three of them constrain the characters
# of a string, and one is a key constraint over a pair of individuals. OWL
# describes what holds in every model of the ontology; these four say what a
# given description has to look like. SHACL is the right instrument for that,
# so they are kept here instead of being silently dropped.
#
# Scope. These are conditions of the *standard*, not of any model that reuses
# this pattern. Everybody who imports mqtt.ttl needs them, which is why they
# are shipped with the pattern rather than with one of its users.
#
# How to run them. Validate the data graph *together with* mqtt.ttl. The reason
# code shape reads the ontology's own appliesToPacket annotations and the class
# hierarchy of the control packets, so it silently finds nothing if the
# ontology is absent. tools/check_shapes.py does it that way and validates the
# shapes against the fixtures in tests/fixtures/.
#
# What is not here. The behaviour of the protocol -- flow control (4.9), the
# authentication exchange (4.12), the ordering of packets. A vocabulary pattern
# and a set of constraints over one graph are both the wrong instrument for a
# protocol flow; see the README.

@prefix sh:        <http://www.w3.org/ns/shacl#> .
@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .
@prefix MQTT:      <http://www.w3id.org/hsu-aut/MQTT#> .
@prefix mqttshape: <http://www.w3id.org/hsu-aut/MQTT/shapes#> .

<http://www.w3id.org/hsu-aut/MQTT/shapes> rdf:type owl:Ontology ;
    rdfs:label "SHACL shapes for the MQTT ODP"@en ;
    rdfs:comment "Constraints of MQTT Version 5.0 that OWL 2 cannot express: wildcards in a topic name (4.7.1), a different topic filter per subscription within a session (1.2), the $share prefix of a shared subscription (4.8.2), and the packet types a reason code may appear in (2.4, Table 2-6)."@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019" ;
    rdfs:seeAlso <http://www.w3id.org/hsu-aut/MQTT> ;
    # Prefix declarations for the SPARQL-based constraints below. SHACL-SPARQL
    # has no access to the Turtle prefixes of this file, so they are repeated
    # here as data.
    sh:declare [ sh:prefix "MQTT" ; sh:namespace "http://www.w3id.org/hsu-aut/MQTT#"^^xsd:anyURI ] ,
               [ sh:prefix "rdf"  ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] .


#################################################################
#    1. A Topic Name must not contain wildcard characters
#################################################################
# 4.7.1, [MQTT-4.7.0-1]: "The wildcard characters can be used in Topic Filters,
# but MUST NOT be used within a Topic Name."
#
# The two shapes target the subjects of the property, not the class MQTT:Topic,
# so that a topic name is checked even when its node carries no type. The
# pattern [+#] is the whole of the condition: the multi-level wildcard '#' and
# the single-level wildcard '+' of 4.7.1. '/' is a level separator, not a
# wildcard, and is allowed anywhere (4.7.1).
#
# A Will Message needs no shape of its own: it is a subclass of
# MQTT:ApplicationMessage and reaches its topic through MQTT:hasTopic, so its
# topic name is a MQTT:topicName like any other (1.2, 3.1.3.3).

mqttshape:TopicNameShape rdf:type sh:NodeShape ;
    rdfs:label "topic name shape"@en ;
    sh:targetSubjectsOf MQTT:topicName ;
    sh:property mqttshape:TopicNameNoWildcards .

mqttshape:TopicNameNoWildcards rdf:type sh:PropertyShape ;
    sh:path MQTT:topicName ;
    sh:pattern "^[^+#]*$" ;
    sh:severity sh:Violation ;
    sh:message "A Topic Name must not contain the wildcard characters '+' or '#'. MQTT 5.0, 4.7.1 [MQTT-4.7.0-1]: 'The wildcard characters can be used in Topic Filters, but MUST NOT be used within a Topic Name.' A string with wildcards is a Topic Filter and belongs on MQTT:topicFilterString."@en ;
    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 4.7.1, 3.3.2.1"@en .


# The Response Topic is a Topic Name used for a reply (3.3.2.3.5), and the
# standard repeats the prohibition for it explicitly.
# [MQTT-3.3.2-14]: "The Response Topic MUST NOT contain wildcard characters."

mqttshape:ResponseTopicShape rdf:type sh:NodeShape ;
    rdfs:label "response topic shape"@en ;
    sh:targetSubjectsOf MQTT:responseTopic ;
    sh:property mqttshape:ResponseTopicNoWildcards .

mqttshape:ResponseTopicNoWildcards rdf:type sh:PropertyShape ;
    sh:path MQTT:responseTopic ;
    sh:pattern "^[^+#]*$" ;
    sh:severity sh:Violation ;
    sh:message "A Response Topic must not contain the wildcard characters '+' or '#'. MQTT 5.0, 3.3.2.3.5 [MQTT-3.3.2-14]: 'The Response Topic MUST NOT contain wildcard characters.'"@en ;
    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.2.3.5"@en .


#################################################################
#    2. Each Subscription within a Session has a different Topic Filter
#################################################################
# 1.2: "A Subscription comprises a Topic Filter and a maximum QoS. A
# Subscription is associated with a single Session. A Session can contain more
# than one Subscription. Each Subscription within a Session has a different
# Topic Filter."
#
# Why OWL cannot do this: it is a key constraint over a *pair* of
# subscriptions, not a property of a single one. OWL 2 has owl:hasKey, but it
# works the other way round -- it would make two subscriptions with the same
# filter the *same* subscription instead of reporting an error, and it is not
# scoped to a session either.
#
# Two constraints, because there are two ways to get it wrong: two
# subscriptions pointing at one Topic Filter node, and two Topic Filter nodes
# carrying the same string. The comparison STR(?s1) < STR(?s2) is only there to
# report each offending pair once instead of twice.

mqttshape:SessionShape rdf:type sh:NodeShape ;
    rdfs:label "session shape"@en ;
    sh:targetSubjectsOf MQTT:hasSubscription ;
    sh:sparql mqttshape:SubscriptionsShareAFilterNode ,
              mqttshape:SubscriptionsShareAFilterString .

mqttshape:SubscriptionsShareAFilterNode rdf:type sh:SPARQLConstraint ;
    sh:severity sh:Violation ;
    sh:message "Two different Subscriptions of this Session are associated with the same Topic Filter {?value}. MQTT 5.0, 1.2: 'Each Subscription within a Session has a different Topic Filter.'"@en ;
    sh:prefixes <http://www.w3id.org/hsu-aut/MQTT/shapes> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this MQTT:hasSubscription ?s1 .
            $this MQTT:hasSubscription ?s2 .
            FILTER (STR(?s1) < STR(?s2))
            ?s1 MQTT:hasTopicFilter ?value .
            ?s2 MQTT:hasTopicFilter ?value .
        }
        """ ;
    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .

mqttshape:SubscriptionsShareAFilterString rdf:type sh:SPARQLConstraint ;
    sh:severity sh:Violation ;
    sh:message "Two different Subscriptions of this Session carry Topic Filters with the same string {?value}. MQTT 5.0, 1.2: 'Each Subscription within a Session has a different Topic Filter.'"@en ;
    sh:prefixes <http://www.w3id.org/hsu-aut/MQTT/shapes> ;
    sh:select """
        SELECT $this ?value
        WHERE {
            $this MQTT:hasSubscription ?s1 .
            $this MQTT:hasSubscription ?s2 .
            FILTER (STR(?s1) < STR(?s2))
            ?s1 MQTT:hasTopicFilter ?f1 .
            ?s2 MQTT:hasTopicFilter ?f2 .
            FILTER (?f1 != ?f2)
            ?f1 MQTT:topicFilterString ?filter .
            ?f2 MQTT:topicFilterString ?filter .
            BIND (?filter AS ?value)
        }
        """ ;
    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


#################################################################
#    3. The Topic Filter of a Shared Subscription starts with $share/
#################################################################
# 4.8.2, [MQTT-4.8.2-1]: "A Shared Subscription's Topic Filter MUST start with
# $share/ and MUST contain a ShareName that is at least one character long."
# [MQTT-4.8.2-2]: "The ShareName MUST NOT contain the characters '/', '+' or
# '#', but MUST be followed by a '/' character. This '/' character MUST be
# followed by a Topic Filter."
#
# The pattern reads as the three parts of $share/{ShareName}/{filter}:
#   ^[$]share/      the literal prefix -- [$] is the dollar sign as a
#                   character class, which saves an escape
#   [^/+#]+         the ShareName: at least one character, none of / + #
#   /.+$            the separator and a filter of at least one character
# It accepts the standard's own examples $share/consumer1/sport/tennis/+ and
# $share/consumer1//finance -- the second one has a zero-length first topic
# level, which 4.7.1 allows.
#
# Two separate shapes on purpose. The pattern is a violation: it says the
# filter is wrong. The missing filter string is only a warning: the model is
# not wrong, but the condition cannot be checked, and a shared subscription
# whose filter string is absent would pass the pattern check silently. Saying
# so is better than passing in silence or failing a model the standard does not
# forbid.

mqttshape:SharedSubscriptionShape rdf:type sh:NodeShape ;
    rdfs:label "shared subscription shape"@en ;
    sh:targetClass MQTT:SharedSubscription ;
    sh:property mqttshape:SharedSubscriptionFilterPrefix ,
                mqttshape:SharedSubscriptionFilterStringPresent .

mqttshape:SharedSubscriptionFilterPrefix rdf:type sh:PropertyShape ;
    sh:path ( MQTT:hasTopicFilter MQTT:topicFilterString ) ;
    sh:pattern "^[$]share/[^/+#]+/.+$" ;
    sh:severity sh:Violation ;
    sh:message "The Topic Filter of a Shared Subscription must have the form $share/{ShareName}/{filter}. MQTT 5.0, 4.8.2 [MQTT-4.8.2-1]: 'A Shared Subscription's Topic Filter MUST start with $share/ and MUST contain a ShareName that is at least one character long.' [MQTT-4.8.2-2]: the ShareName must not contain '/', '+' or '#' and must be followed by a '/' and a Topic Filter."@en ;
    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 4.8.2"@en .

mqttshape:SharedSubscriptionFilterStringPresent rdf:type sh:PropertyShape ;
    sh:path ( MQTT:hasTopicFilter MQTT:topicFilterString ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "This Shared Subscription has no MQTT:topicFilterString, so the $share/ prefix required by 4.8.2 cannot be checked."@en ;
    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 4.8.2"@en .


#################################################################
#    4. A Reason Code appears only in the packet types Table 2-6 lists
#################################################################
# 2.4 with Table 2-6 states, for each of the 45 Reason Codes, which control
# packets may carry it. mqtt.ttl records that as the annotation
# MQTT:appliesToPacket on the Reason Code individuals: 45 codes against 9
# packet types would be up to 405 axioms without any reasoning benefit, and an
# annotation is invisible to a reasoner by design. This shape is what gives the
# annotation teeth.
#
# The query asks: does the packet have a type that is one of the control packet
# classes, and is that type absent from the appliesToPacket annotations of the
# code it carries? A packet typed only as MQTT:MQTTControlPacket is not
# reported -- its type is not a subclass of itself, so nothing is known about
# which codes it may carry and nothing is claimed.
#
# This is the one shape that needs mqtt.ttl in the data graph: both the
# annotations and the class hierarchy come from the ontology.

mqttshape:ReasonCodeInPacketShape rdf:type sh:NodeShape ;
    rdfs:label "reason code in packet shape"@en ;
    sh:targetSubjectsOf MQTT:hasReasonCode ;
    sh:sparql mqttshape:ReasonCodeNotAllowedInPacketType .

mqttshape:ReasonCodeNotAllowedInPacketType rdf:type sh:SPARQLConstraint ;
    sh:severity sh:Violation ;
    sh:message "Reason Code {?value} is not allowed in a packet of type {?packetType}. MQTT 5.0, 2.4, Table 2-6 lists the packet types for each Reason Code; they are recorded as MQTT:appliesToPacket on the Reason Code."@en ;
    sh:prefixes <http://www.w3id.org/hsu-aut/MQTT/shapes> ;
    sh:select """
        SELECT $this ?value ?packetType
        WHERE {
            $this MQTT:hasReasonCode ?value .
            $this rdf:type ?packetType .
            ?packetType rdfs:subClassOf MQTT:MQTTControlPacket .
            FILTER NOT EXISTS { ?value MQTT:appliesToPacket ?packetType }
        }
        """ ;
    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4, Tab. 2-6"@en .
