                                               rdfs:comment "Reason Code 0x9E (Shared Subscriptions not supported), indicates failure. Allowed in: SUBACK, DISCONNECT (2.4, Table 2-6)." ;
                                               rdfs:label "Shared Subscriptions not supported"@en ;
