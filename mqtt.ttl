###  http://www.w3id.org/hsu-aut/MQTT#ReasonCodeQoSNotSupported
MQTT:ReasonCodeQoSNotSupported rdf:type owl:NamedIndividual ,
                                        MQTT:ReasonCode ;
                               MQTT:reasonCodeValue "155"^^xsd:unsignedByte ;
                               MQTT:appliesToPacket MQTT:Connack ;
                               MQTT:appliesToPacket MQTT:Disconnect ;
                               rdfs:comment "Reason Code 0x9B (QoS not supported), indicates failure. Allowed in: CONNACK, DISCONNECT (2.4, Table 2-6)." ;
                               rdfs:label "QoS not supported"@en ;
                               dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4, Tab. 2-6"@en .


