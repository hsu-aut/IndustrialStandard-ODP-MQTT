                                                 MQTT:appliesToPacket MQTT:Suback ;
                                                 MQTT:appliesToPacket MQTT:Disconnect ;
                                                 rdfs:comment "Reason Code 0xA2 (Wildcard Subscriptions not supported), indicates failure. Allowed in: SUBACK, DISCONNECT (2.4, Table 2-6)." ;
