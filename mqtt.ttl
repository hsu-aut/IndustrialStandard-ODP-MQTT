MQTT:ReasonCodeSubscriptionIdentifiersNotSupported rdf:type owl:NamedIndividual ,
                                                            MQTT:ReasonCode ;
                                                   MQTT:reasonCodeValue "161"^^xsd:unsignedByte ;
                                                   MQTT:appliesToPacket MQTT:Suback ;
                                                   MQTT:appliesToPacket MQTT:Disconnect ;
                                                   rdfs:comment "Reason Code 0xA1 (Subscription Identifiers not supported), indicates failure. Allowed in: SUBACK, DISCONNECT (2.4, Table 2-6)." ;
                                                   rdfs:label "Subscription Identifiers not supported"@en ;
