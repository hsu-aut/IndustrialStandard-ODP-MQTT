@prefix : <http://www.w3id.org/hsu-aut/MQTT#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix MQTT: <http://www.w3id.org/hsu-aut/MQTT#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <http://www.w3id.org/hsu-aut/MQTT#> .

<http://www.w3id.org/hsu-aut/MQTT> rdf:type owl:Ontology ;
                                    owl:versionIRI <http://www.w3id.org/hsu-aut/MQTT/6.0.1> ;
                                    rdfs:comment "MQTT (Message Queuing Telemetry Transport) Ontology representing the MQTT v5.0 protocol standard as defined by OASIS. This ontology captures the core concepts of MQTT including clients, servers, connections, control packets, topics, subscriptions, and message exchange patterns. Every entity carries a dcterms:source annotation naming the clause of the standard it reflects." ;
                                    owl:versionInfo "6.0.1" ;
                                    rdfs:label "MQTT"@en ;
                                    dcterms:title "MQTT - An Ontology Design Pattern for the MQTT Version 5.0 Protocol"@en ;
                                    dcterms:description "Ontology design pattern of the OASIS MQTT Version 5.0 standard. It covers the normative vocabulary of clause 1.2, the fifteen control packet types of clause 2.1.2, topics and topic filters, sessions and subscriptions, and the three quality of service levels, so that publish/subscribe communication can be described in a standard-based way."@en ;
                                    dcterms:creator "Luis Miguel Vieira da Silva" ;
                                    dcterms:publisher "Helmut-Schmidt-University, Institute of Automation Technology" ;
                                    dcterms:license <https://opensource.org/licenses/MIT> ;
                                    dcterms:created "2025-08-08"^^xsd:date ;
                                    dcterms:modified "2026-11-06"^^xsd:date ;
                                    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019" ;
                                    dcterms:bibliographicCitation "A. Banks, E. Briggs, K. Borgendale, R. Gupta (eds.): MQTT Version 5.0. OASIS Standard, 07 March 2019. https://docs.oasis-open.org/mqtt/mqtt/v5.0/os/mqtt-v5.0-os.html" ;
                                    vann:preferredNamespacePrefix "MQTT" ;
                                    vann:preferredNamespaceUri "http://www.w3id.org/hsu-aut/MQTT#" ;
                                    rdfs:seeAlso <https://docs.oasis-open.org/mqtt/mqtt/v5.0/os/mqtt-v5.0-os.html> .

#################################################################
#    Annotation properties used in the metadata
#################################################################
# Declared explicitly so that the ontology stays within OWL 2 DL.

dcterms:title rdf:type owl:AnnotationProperty .
dcterms:description rdf:type owl:AnnotationProperty .
dcterms:creator rdf:type owl:AnnotationProperty .
dcterms:publisher rdf:type owl:AnnotationProperty .
dcterms:license rdf:type owl:AnnotationProperty .
dcterms:created rdf:type owl:AnnotationProperty .
dcterms:modified rdf:type owl:AnnotationProperty .
dcterms:source rdf:type owl:AnnotationProperty .
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty .
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .

###  http://www.w3id.org/hsu-aut/MQTT#packetTypeValue
# The numeric value of a packet type (2.1.2, Tab. 2-1), annotated on the class.
MQTT:packetTypeValue rdf:type owl:AnnotationProperty ;
                     rdfs:label "packet type value"@en ;
                     rdfs:comment "The four-bit value that identifies a control packet type on the wire (2.1.2, Tab. 2-1)." ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.1.2, Tab. 2-1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#appliesToPacket
# Records which control packet types a Reason Code is allowed in
# (2.4, Table 2-6).
MQTT:appliesToPacket rdf:type owl:AnnotationProperty ;
                     rdfs:label "applies to packet"@en ;
                     rdfs:comment "The control packet types in which a Reason Code may appear (2.4, Table 2-6)." ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4, Tab. 2-6"@en .

#################################################################
#    Object Properties
#################################################################

###  http://www.w3id.org/hsu-aut/MQTT#connectsTo
MQTT:connectsTo rdf:type owl:ObjectProperty ;
                owl:propertyChainAxiom ( [ owl:inverseOf MQTT:isSessionOfClient ]
                                         MQTT:isSessionOnServer
                                       ) ;
                owl:propertyChainAxiom ( MQTT:usesConnection
                                         MQTT:hasSession
                                         MQTT:isSessionOnServer
                                       ) ;
                rdfs:domain MQTT:MQTTClient ;
                rdfs:range MQTT:MQTTServer ;
                rdfs:comment "Relates an MQTT Client to an MQTT Server it talks to, through the Session between them (1.2) or through the Network Connection it uses." ;
                rdfs:label "connects to"@en ;
                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasApplicationMessage
MQTT:hasApplicationMessage rdf:type owl:ObjectProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:domain MQTT:Publish ;
                           rdfs:range MQTT:ApplicationMessage ;
                           rdfs:comment "Associates a PUBLISH packet with its Application Message. 3.3.3: 'The Payload contains the Application Message that is being published.'" ;
                           rdfs:label "has application message"@en ;
                           dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasControlPacket
MQTT:hasControlPacket rdf:type owl:ObjectProperty ;
                      rdfs:domain MQTT:MQTTConnection ;
                      rdfs:range MQTT:MQTTControlPacket ;
                      rdfs:comment "Associates an MQTT connection with control packets exchanged over it." ;
                      rdfs:label "has control packet"@en ;
                      dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasFixedHeader
MQTT:hasFixedHeader rdf:type owl:ObjectProperty ;
                    rdfs:domain MQTT:MQTTControlPacket ;
                    rdfs:range MQTT:FixedHeader ;
                    rdfs:comment "Associates an MQTT Control Packet with its fixed header." ;
                    rdfs:label "has fixed header"@en ;
                    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.1.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasMaximumQoS
MQTT:hasMaximumQoS rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain MQTT:Subscription ;
                   rdfs:range MQTT:QoS ;
                   rdfs:comment "Associates a Subscription with its maximum Quality of Service, 'the maximum QoS level at which the Server can send Application Messages to the Client' (1.2, 3.8.3.1)." ;
                   rdfs:label "has maximum QoS"@en ;
                   dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 3.8.3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasPayload
MQTT:hasPayload rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain MQTT:MQTTControlPacket ;
                rdfs:range MQTT:Payload ;
                rdfs:comment "Associates an MQTT Control Packet with its Payload, the last of the up to three parts of a packet (2.1). Which packet types carry one is stated per packet type at the end of this file, from 2.3 Table 2-5." ;
                rdfs:label "has payload"@en ;
                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasProperty
MQTT:hasProperty rdf:type owl:ObjectProperty ;
                 rdfs:domain MQTT:MQTTControlPacket ;
                 rdfs:range MQTT:MQTTProperty ;
                 rdfs:comment "Associates an MQTT Control Packet with a set of Properties (2.2.2). A CONNECT has two: the set at the end of its Variable Header and the optional set in the Will Properties field with the Payload." ;
                 rdfs:label "has property"@en ;
                 dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.2.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasUserProperty
MQTT:hasUserProperty rdf:type owl:ObjectProperty ;
                     rdfs:domain MQTT:MQTTProperty ;
                     rdfs:range MQTT:UserProperty ;
                     rdfs:comment "Relates the set of Properties of a packet to a User Property it contains. 2.2.2.2: the User Property 'is allowed to appear multiple times to represent multiple name, value pairs', and the same name may appear more than once." ;
                     rdfs:label "has user property"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.2.2.2, Tab. 2-4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasPayloadFormat
MQTT:hasPayloadFormat rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain MQTT:ApplicationMessage ;
                      rdfs:range MQTT:PayloadFormat ;
                      rdfs:comment "Relates an Application Message to the format of its payload data (3.3.2.3.2)." ;
                      rdfs:label "has payload format"@en ;
                      dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.2.3.2, Tab. 2-4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasQoS
MQTT:hasQoS rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain MQTT:ApplicationMessage ;
            rdfs:range MQTT:QoS ;
            rdfs:comment "Associates an Application Message with the Quality of Service it is delivered with. 1.2: 'When an Application Message is transported by MQTT it contains payload data, a Quality of Service (QoS), a collection of Properties, and a Topic Name.'" ;
            rdfs:label "has QoS"@en ;
            dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 3.3.1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasReasonCode
MQTT:hasReasonCode rdf:type owl:ObjectProperty ;
                   rdfs:domain MQTT:MQTTControlPacket ;
                   rdfs:range MQTT:ReasonCode ;
                   rdfs:comment "Relates a control packet to a Reason Code it carries. 2.4: CONNACK, PUBACK, PUBREC, PUBREL, PUBCOMP, DISCONNECT and AUTH carry a single Reason Code in the Variable Header, SUBACK and UNSUBACK a list of one or more in the Payload." ;
                   rdfs:label "has reason code"@en ;
                   dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasRequestedTopicFilter
MQTT:hasRequestedTopicFilter rdf:type owl:ObjectProperty ;
                             rdfs:domain MQTT:Subscribe ;
                             rdfs:range MQTT:TopicFilter ;
                             rdfs:comment "Relates a SUBSCRIBE packet to a Topic Filter it requests a subscription for. 3.8.3: 'The Payload of a SUBSCRIBE packet contains a list of Topic Filters indicating the Topics to which the Client wants to subscribe.'" ;
                             rdfs:label "has requested topic filter"@en ;
                             dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.8.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#grantsQoS
MQTT:grantsQoS rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain MQTT:ReasonCode ;
               rdfs:range MQTT:QoS ;
               rdfs:comment "Relates one of the three SUBACK Reason Codes Granted QoS 0, 1 and 2 to the QoS level it grants (2.4, Table 2-6; 3.9.3). Only those three Reason Codes carry it." ;
               rdfs:label "grants QoS"@en ;
               dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4, Tab. 2-6"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasResponseTopic
MQTT:hasResponseTopic rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain MQTT:ApplicationMessage ;
                      rdfs:range MQTT:Topic ;
                      rdfs:comment "Relates an Application Message to the Topic a response to it is to be published on. 3.3.2.3.5: the Response Topic 'is used as the Topic Name for a response message'." ;
                      rdfs:label "has response topic"@en ;
                      dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.2.3.5, Tab. 2-4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasRetainHandling
MQTT:hasRetainHandling rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain MQTT:Subscription ;
                       rdfs:range MQTT:RetainHandling ;
                       rdfs:comment "Relates a Subscription to its Retain Handling option, which specifies whether retained messages are sent when the subscription is established (3.8.3.1)." ;
                       rdfs:label "has retain handling"@en ;
                       dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.8.3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasRevokedTopicFilter
MQTT:hasRevokedTopicFilter rdf:type owl:ObjectProperty ;
                           rdfs:domain MQTT:Unsubscribe ;
                           rdfs:range MQTT:TopicFilter ;
                           rdfs:comment "Relates an UNSUBSCRIBE packet to a Topic Filter it ends the subscription for. 3.10.3: 'The Payload for the UNSUBSCRIBE packet contains the list of Topic Filters that the Client wishes to unsubscribe from.'" ;
                           rdfs:label "has revoked topic filter"@en ;
                           dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.10.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasSession
MQTT:hasSession rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain MQTT:MQTTConnection ;
                rdfs:range MQTT:MQTTSession ;
                rdfs:comment "Associates a Network Connection with its Session. A Session 'can continue across a sequence of Network Connections' (4.1)." ;
                rdfs:label "has session"@en ;
                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 4.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasSubscription
MQTT:hasSubscription rdf:type owl:ObjectProperty ;
                     rdfs:domain MQTT:MQTTSession ;
                     rdfs:range MQTT:Subscription ;
                     rdfs:comment "Associates an MQTT session with its subscriptions." ;
                     rdfs:label "has subscription"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 4.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasTopic
MQTT:hasTopic rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain MQTT:ApplicationMessage ;
              rdfs:range MQTT:Topic ;
              rdfs:comment "Associates an Application Message with its Topic Name, 'the label attached to an Application Message which is matched against the Subscriptions known to the Server' (1.2)." ;
              rdfs:label "has topic"@en ;
              dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasTopicFilter
MQTT:hasTopicFilter rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain MQTT:Subscription ;
                    rdfs:range MQTT:TopicFilter ;
                    rdfs:comment "Associates a subscription with its topic filter." ;
                    rdfs:label "has topic filter"@en ;
                    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasVariableHeader
MQTT:hasVariableHeader rdf:type owl:ObjectProperty ;
                       rdfs:domain MQTT:MQTTControlPacket ;
                       rdfs:range MQTT:VariableHeader ;
                       rdfs:comment "Associates an MQTT Control Packet with its variable header." ;
                       rdfs:label "has variable header"@en ;
                       dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#hasWillMessage
MQTT:hasWillMessage rdf:type owl:ObjectProperty ;
                    rdfs:domain MQTT:Connect ;
                    rdfs:range MQTT:WillMessage ;
                    rdfs:comment "Associates a CONNECT packet with its will message." ;
                    rdfs:label "has will message"@en ;
                    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.3.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#isSessionOfClient
MQTT:isSessionOfClient rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain MQTT:MQTTSession ;
                       rdfs:range MQTT:MQTTClient ;
                       rdfs:comment "Relates a Session to the Client it belongs to. 1.2 defines a Session as 'a stateful interaction between a Client and a Server'; 4.1 associates the Session State with the Client Identifier." ;
                       rdfs:label "is session of client"@en ;
                       dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 4.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#isSessionOnServer
MQTT:isSessionOnServer rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain MQTT:MQTTSession ;
                       rdfs:range MQTT:MQTTServer ;
                       rdfs:comment "Relates a Session to the Server it is held on. 1.2: a Session is 'a stateful interaction between a Client and a Server'." ;
                       rdfs:label "is session on server"@en ;
                       dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#publishesTo
MQTT:publishesTo rdf:type owl:ObjectProperty ;
                 rdfs:domain MQTT:MQTTClient ;
                 rdfs:range MQTT:Topic ;
                 rdfs:comment "Indicates that a Client publishes Application Messages to a Topic (1.2)." ;
                 rdfs:label "publishes to"@en ;
                 dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#respondsTo
MQTT:respondsTo rdf:type owl:ObjectProperty ;
                rdfs:domain MQTT:MQTTControlPacket ;
                rdfs:range MQTT:MQTTControlPacket ;
                rdfs:comment "Associates response packets with their corresponding request packets." ;
                rdfs:label "responds to"@en ;
                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.2.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#subscribesTo
MQTT:subscribesTo rdf:type owl:ObjectProperty ;
                  owl:propertyChainAxiom ( [ owl:inverseOf MQTT:isSessionOfClient ]
                                           MQTT:hasSubscription
                                           MQTT:hasTopicFilter
                                         ) ;
                  rdfs:domain MQTT:MQTTClient ;
                  rdfs:range MQTT:TopicFilter ;
                  rdfs:comment "Indicates that a Client subscribes to messages matching a Topic Filter (1.2). Follows from the Topic Filter of a Subscription in a Session of that Client." ;
                  rdfs:label "subscribes to"@en ;
                  dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#supportsMaximumQoS
MQTT:supportsMaximumQoS rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain MQTT:MQTTServer ;
                        rdfs:range MQTT:QoS ;
                        rdfs:comment "The highest Quality of Service a Server supports for PUBLISH packets. 3.2.2.3.4: 'If a Server does not support QoS 1 or QoS 2 PUBLISH packets it MUST send a Maximum QoS in the CONNACK packet specifying the highest QoS it supports.' Absence of the value means QoS 2." ;
                        rdfs:label "supports maximum QoS"@en ;
                        dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.2.2.3.4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#usesConnection
MQTT:usesConnection rdf:type owl:ObjectProperty ;
                    rdfs:domain MQTT:MQTTClient ;
                    rdfs:range MQTT:MQTTConnection ;
                    rdfs:comment "Associates a client with its network connection." ;
                    rdfs:label "uses connection"@en ;
                    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.w3id.org/hsu-aut/MQTT#assignedClientIdentifier
MQTT:assignedClientIdentifier rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain MQTT:Connack ;
                              rdfs:range xsd:string ;
                              rdfs:comment "The Client Identifier assigned by the Server, sent in the CONNACK when the Client connected with a zero-length Client Identifier (3.2.2.3.7)." ;
                              rdfs:label "assigned client identifier"@en ;
                              dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.2.2.3.7"@en .


###  http://www.w3id.org/hsu-aut/MQTT#authenticationData
MQTT:authenticationData rdf:type owl:DatatypeProperty ;
                        rdfs:domain MQTT:MQTTProperty ;
                        rdfs:range xsd:base64Binary ;
                        rdfs:comment "Binary data for authentication purposes." ;
                        rdfs:label "authentication data"@en ;
                        dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.11.10"@en .


###  http://www.w3id.org/hsu-aut/MQTT#authenticationMethod
MQTT:authenticationMethod rdf:type owl:DatatypeProperty ;
                          rdfs:domain MQTT:MQTTProperty ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Specifies the authentication method used." ;
                          rdfs:label "authentication method"@en ;
                          dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.11.9"@en .


###  http://www.w3id.org/hsu-aut/MQTT#cleanStart
MQTT:cleanStart rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain MQTT:Connect ;
                rdfs:range xsd:boolean ;
                rdfs:comment "The Clean Start flag of a CONNECT packet. If true, the Server discards any existing Session and starts a new one; if false, it resumes the Session associated with the Client Identifier if one exists (3.1.2.4)." ;
                rdfs:label "clean start"@en ;
                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#clientId
MQTT:clientId rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain MQTT:MQTTClient ;
              rdfs:range xsd:string ;
              rdfs:comment "The Client Identifier (ClientID) of a Client. 3.1.3.1: 'The Client Identifier (ClientID) identifies the Client to the Server. Each Client connecting to the Server has a unique ClientID.'" ;
              rdfs:label "client identifier"@en ;
              dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#contentType
MQTT:contentType rdf:type owl:DatatypeProperty ;
                 rdfs:domain MQTT:ApplicationMessage ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Describes the content type of the application message payload." ;
                 rdfs:label "content type"@en ;
                 dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.2.3.9"@en .


###  http://www.w3id.org/hsu-aut/MQTT#correlationData
MQTT:correlationData rdf:type owl:DatatypeProperty ;
                     rdfs:domain MQTT:ApplicationMessage ;
                     rdfs:range xsd:base64Binary ;
                     rdfs:comment "Binary data used for request-response correlation." ;
                     rdfs:label "correlation data"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.2.3.6"@en .


###  http://www.w3id.org/hsu-aut/MQTT#dupFlag
MQTT:dupFlag rdf:type owl:DatatypeProperty ;
             rdfs:domain MQTT:FixedHeader ;
             rdfs:range xsd:boolean ;
             rdfs:comment "Indicates if this is a duplicate delivery of a PUBLISH packet." ;
             rdfs:label "DUP flag"@en ;
             dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.1.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#endpointUrl
MQTT:endpointUrl rdf:type owl:DatatypeProperty ;
                 rdfs:domain MQTT:MQTTServer ;
                 rdfs:range xsd:anyURI ;
                 rdfs:comment "The URI a Server can be reached at, for example mqtt://broker.example:1883 or mqtts://broker.example:8883. A Server can be reachable at several URIs, one per network interface or transport." ;
                 rdfs:label "endpoint URL"@en ;
                 dcterms:source "Extension beyond MQTT Version 5.0: not defined in the standard. The word appears once, non-definitionally, in 3.1.4: 'a Server MAY support multiple protocols [...] on the same TCP port or other network endpoint'."@en .


###  http://www.w3id.org/hsu-aut/MQTT#keepAlive
MQTT:keepAlive rdf:type owl:DatatypeProperty ;
               rdfs:domain MQTT:Connect ;
               rdfs:range xsd:unsignedShort ;
               rdfs:comment "The keep alive interval in seconds." ;
               rdfs:label "keep alive"@en ;
               dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.10"@en .


###  http://www.w3id.org/hsu-aut/MQTT#maximumPacketSize
MQTT:maximumPacketSize rdf:type owl:DatatypeProperty ;
                       rdfs:domain MQTT:MQTTProperty ;
                       rdfs:range xsd:unsignedInt ;
                       rdfs:comment "Maximum packet size that can be received." ;
                       rdfs:label "maximum packet size"@en ;
                       dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.11.4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#messageExpiryInterval
MQTT:messageExpiryInterval rdf:type owl:DatatypeProperty ;
                           rdfs:domain MQTT:ApplicationMessage ;
                           rdfs:range xsd:unsignedInt ;
                           rdfs:comment "Message expiry interval in seconds." ;
                           rdfs:label "message expiry interval"@en ;
                           dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.2.3.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#noLocal
MQTT:noLocal rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain MQTT:Subscription ;
             rdfs:range xsd:boolean ;
             rdfs:comment "The No Local option of a Subscription. If true, Application Messages are not forwarded to a connection with the same Client Identifier as the publishing connection (3.8.3.1). It is a Protocol Error to set it on a Shared Subscription." ;
             rdfs:label "no local"@en ;
             dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.8.3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#packetIdentifier
MQTT:packetIdentifier rdf:type owl:DatatypeProperty ;
                      rdfs:domain MQTT:VariableHeader ;
                      rdfs:range xsd:unsignedShort ;
                      rdfs:comment "The packet identifier for control packets that require one." ;
                      rdfs:label "packet identifier"@en ;
                      dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.2.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#password
MQTT:password rdf:type owl:DatatypeProperty ;
              rdfs:domain MQTT:Connect ;
              rdfs:range xsd:base64Binary ;
              rdfs:comment "The Password field of the CONNECT payload. 3.1.3.6: 'The Password field is Binary Data. Although this field is called Password, it can be used to carry any credential information.'" ;
              rdfs:label "password"@en ;
              dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.3.6"@en .


###  http://www.w3id.org/hsu-aut/MQTT#protocolName
MQTT:protocolName rdf:type owl:DatatypeProperty ;
                  rdfs:domain MQTT:Connect ;
                  rdfs:range xsd:string ;
                  rdfs:comment "The protocol name, must be 'MQTT'." ;
                  rdfs:label "protocol name"@en ;
                  dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#protocolVersion
MQTT:protocolVersion rdf:type owl:DatatypeProperty ;
                     rdfs:domain MQTT:Connect ;
                     rdfs:range xsd:unsignedByte ;
                     rdfs:comment "The protocol version, 5 for MQTT v5.0." ;
                     rdfs:label "protocol version"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#payloadFormatValue
MQTT:payloadFormatValue rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain MQTT:PayloadFormat ;
                        rdfs:range xsd:unsignedByte ;
                        rdfs:comment "The numeric value of a payload format: 0 for unspecified bytes, 1 for UTF-8 encoded character data (3.3.2.3.2)." ;
                        rdfs:label "payload format value"@en ;
                        dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.2.3.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#propertyName
MQTT:propertyName rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain MQTT:UserProperty ;
                  rdfs:range xsd:string ;
                  rdfs:comment "The name half of the UTF-8 String Pair of a User Property (2.2.2.2)." ;
                  rdfs:label "property name"@en ;
                  dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.2.2.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#propertyValue
MQTT:propertyValue rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain MQTT:UserProperty ;
                   rdfs:range xsd:string ;
                   rdfs:comment "The value half of the UTF-8 String Pair of a User Property (2.2.2.2)." ;
                   rdfs:label "property value"@en ;
                   dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.2.2.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#qosLevel
MQTT:qosLevel rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain MQTT:QoS ;
              rdfs:range xsd:unsignedByte ;
              rdfs:comment "The numeric level of a Quality of Service, as given in Table 3-2: 0, 1 or 2. The value 3 is reserved and must not be used." ;
              rdfs:label "QoS level"@en ;
              dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.1.2, Tab. 3-2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#reasonCodeValue
MQTT:reasonCodeValue rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain MQTT:ReasonCode ;
                     rdfs:range xsd:unsignedByte ;
                     rdfs:comment "The one byte unsigned value of a Reason Code. 2.4: 'Reason Codes less than 0x80 indicate successful completion of an operation [...] values of 0x80 or greater indicate failure.' Several Reason Codes can share a value." ;
                     rdfs:label "reason code value"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4, Tab. 2-6"@en .


###  http://www.w3id.org/hsu-aut/MQTT#reasonString
MQTT:reasonString rdf:type owl:DatatypeProperty ;
                  rdfs:domain MQTT:MQTTProperty ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Human readable string describing the reason for a response." ;
                  rdfs:label "reason string"@en ;
                  dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.2.2.2, Tab. 2-4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#receiveMaximum
MQTT:receiveMaximum rdf:type owl:DatatypeProperty ;
                    rdfs:domain MQTT:MQTTProperty ;
                    rdfs:range xsd:unsignedShort ;
                    rdfs:comment "Maximum number of QoS 1 and QoS 2 publications to process concurrently." ;
                    rdfs:label "receive maximum"@en ;
                    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.11.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#remainingLength
MQTT:remainingLength rdf:type owl:DatatypeProperty ;
                     rdfs:domain MQTT:FixedHeader ;
                     rdfs:range xsd:unsignedInt ;
                     rdfs:comment "The remaining length field indicating bytes remaining in the packet." ;
                     rdfs:label "remaining length"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.1.4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#requestProblemInformation
MQTT:requestProblemInformation rdf:type owl:DatatypeProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain MQTT:Connect ;
                               rdfs:range xsd:boolean ;
                               rdfs:comment "Whether the Client asks the Server to send a Reason String or User Properties in case of failure (3.1.2.11.7). A value other than 0 or 1 is a Protocol Error." ;
                               rdfs:label "request problem information"@en ;
                               dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.11.7"@en .


###  http://www.w3id.org/hsu-aut/MQTT#requestResponseInformation
MQTT:requestResponseInformation rdf:type owl:DatatypeProperty ,
                                         owl:FunctionalProperty ;
                                rdfs:domain MQTT:Connect ;
                                rdfs:range xsd:boolean ;
                                rdfs:comment "Whether the Client asks the Server to return Response Information in the CONNACK (3.1.2.11.6). A value other than 0 or 1 is a Protocol Error." ;
                                rdfs:label "request response information"@en ;
                                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.11.6"@en .


###  http://www.w3id.org/hsu-aut/MQTT#responseInformation
MQTT:responseInformation rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain MQTT:Connack ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Information returned by the Server that the Client can use as the basis of a response topic, sent in the CONNACK (3.2.2.3.15)." ;
                         rdfs:label "response information"@en ;
                         dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.2.2.3.15"@en .


###  http://www.w3id.org/hsu-aut/MQTT#retainAsPublished
MQTT:retainAsPublished rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain MQTT:Subscription ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "The Retain As Published option of a Subscription. If true, application messages forwarded through this subscription keep the RETAIN flag they were published with; if false, the flag is set to 0 (3.8.3.1, bit 3 of the Subscription Options)." ;
                       rdfs:label "retain as published"@en ;
                       dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.8.3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#retainFlag
MQTT:retainFlag rdf:type owl:DatatypeProperty ;
                rdfs:domain MQTT:FixedHeader ;
                rdfs:range xsd:boolean ;
                rdfs:comment "Indicates if the message should be retained by the server." ;
                rdfs:label "RETAIN flag"@en ;
                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.1.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#retainHandlingValue
MQTT:retainHandlingValue rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain MQTT:RetainHandling ;
                         rdfs:range xsd:unsignedByte ;
                         rdfs:comment "The numeric value of a Retain Handling option: 0 send retained messages at the time of the subscribe, 1 send them only if the subscription does not currently exist, 2 do not send them. The value 3 is a Protocol Error (3.8.3.1)." ;
                         rdfs:label "retain handling value"@en ;
                         dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.8.3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#serverKeepAlive
MQTT:serverKeepAlive rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain MQTT:Connack ;
                     rdfs:range xsd:unsignedShort ;
                     rdfs:comment "The Keep Alive the Server assigns in the CONNACK, which the Client must use instead of the one it sent in the CONNECT (3.2.2.3.14)." ;
                     rdfs:label "server keep alive"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.2.2.3.14"@en .


###  http://www.w3id.org/hsu-aut/MQTT#serverReference
MQTT:serverReference rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain MQTT:MQTTProperty ;
                     rdfs:range xsd:string ;
                     rdfs:comment "A reference to another Server the Client should use instead, sent in a CONNACK or DISCONNECT when the Server redirects the Client (3.2.2.3.16, 3.14.2.2.5, 4.11)." ;
                     rdfs:label "server reference"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.2.2.3.16, 3.14.2.2.5"@en .


###  http://www.w3id.org/hsu-aut/MQTT#sessionExpiryInterval
MQTT:sessionExpiryInterval rdf:type owl:DatatypeProperty ;
                           rdfs:domain MQTT:MQTTSession ;
                           rdfs:range xsd:unsignedInt ;
                           rdfs:comment "Session expiry interval in seconds." ;
                           rdfs:label "session expiry interval"@en ;
                           dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.11.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#sessionPresent
MQTT:sessionPresent rdf:type owl:DatatypeProperty ;
                    rdfs:domain MQTT:Connack ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Indicates whether a session is present on the server." ;
                    rdfs:label "session present"@en ;
                    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.2.2.1.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#subscriptionIdentifier
MQTT:subscriptionIdentifier rdf:type owl:DatatypeProperty ;
                            rdfs:domain MQTT:Subscription ;
                            rdfs:range xsd:unsignedInt ;
                            rdfs:comment "Identifier for the subscription." ;
                            rdfs:label "subscription identifier"@en ;
                            dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.8.2.1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#supportsRetain
MQTT:supportsRetain rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain MQTT:MQTTServer ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Whether the Server supports retained messages. 3.2.2.3.5: 'this byte declares whether the Server supports retained messages'; absence means it does." ;
                    rdfs:label "supports retain"@en ;
                    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.2.2.3.5"@en .


###  http://www.w3id.org/hsu-aut/MQTT#supportsSharedSubscriptions
MQTT:supportsSharedSubscriptions rdf:type owl:DatatypeProperty ,
                                          owl:FunctionalProperty ;
                                 rdfs:domain MQTT:MQTTServer ;
                                 rdfs:range xsd:boolean ;
                                 rdfs:comment "Whether the Server supports Shared Subscriptions (3.2.2.3.13); absence means it does." ;
                                 rdfs:label "supports shared subscriptions"@en ;
                                 dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.2.2.3.13"@en .


###  http://www.w3id.org/hsu-aut/MQTT#supportsSubscriptionIdentifiers
MQTT:supportsSubscriptionIdentifiers rdf:type owl:DatatypeProperty ,
                                              owl:FunctionalProperty ;
                                     rdfs:domain MQTT:MQTTServer ;
                                     rdfs:range xsd:boolean ;
                                     rdfs:comment "Whether the Server supports Subscription Identifiers (3.2.2.3.12); absence means it does." ;
                                     rdfs:label "supports subscription identifiers"@en ;
                                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.2.2.3.12"@en .


###  http://www.w3id.org/hsu-aut/MQTT#supportsWildcardSubscriptions
MQTT:supportsWildcardSubscriptions rdf:type owl:DatatypeProperty ,
                                            owl:FunctionalProperty ;
                                   rdfs:domain MQTT:MQTTServer ;
                                   rdfs:range xsd:boolean ;
                                   rdfs:comment "Whether the Server supports Wildcard Subscriptions (3.2.2.3.11); absence means it does." ;
                                   rdfs:label "supports wildcard subscriptions"@en ;
                                   dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.2.2.3.11"@en .


###  http://www.w3id.org/hsu-aut/MQTT#topicAlias
MQTT:topicAlias rdf:type owl:DatatypeProperty ;
                rdfs:domain MQTT:Publish ;
                rdfs:range xsd:unsignedShort ;
                rdfs:comment "An integer value used to identify the Topic instead of using the Topic Name, in order to reduce the size of the PUBLISH packet (3.3.2.3.4)." ;
                rdfs:label "topic alias"@en ;
                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.2.3.4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#topicAliasMaximum
MQTT:topicAliasMaximum rdf:type owl:DatatypeProperty ;
                       rdfs:domain MQTT:MQTTProperty ;
                       rdfs:range xsd:unsignedShort ;
                       rdfs:comment "Maximum topic alias value that can be used." ;
                       rdfs:label "topic alias maximum"@en ;
                       dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.11.5"@en .


###  http://www.w3id.org/hsu-aut/MQTT#topicFilterString
MQTT:topicFilterString rdf:type owl:DatatypeProperty ;
                       rdfs:domain MQTT:TopicFilter ;
                       rdfs:range xsd:string ;
                       rdfs:comment "The topic filter string that may contain wildcards." ;
                       rdfs:label "topic filter string"@en ;
                       dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 4.7"@en .


###  http://www.w3id.org/hsu-aut/MQTT#topicName
MQTT:topicName rdf:type owl:DatatypeProperty ;
               rdfs:domain MQTT:Topic ;
               rdfs:range xsd:string ;
               rdfs:comment "The topic name string." ;
               rdfs:label "topic name"@en ;
               dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 3.3.2.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#userName
MQTT:userName rdf:type owl:DatatypeProperty ;
              rdfs:domain MQTT:Connect ;
              rdfs:range xsd:string ;
              rdfs:comment "User name for client authentication." ;
              rdfs:label "user name"@en ;
              dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.3.5"@en .


###  http://www.w3id.org/hsu-aut/MQTT#willDelayInterval
MQTT:willDelayInterval rdf:type owl:DatatypeProperty ;
                       rdfs:domain MQTT:WillMessage ;
                       rdfs:range xsd:unsignedInt ;
                       rdfs:comment "Delay interval before publishing the will message." ;
                       rdfs:label "will delay interval"@en ;
                       dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.3.2.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#willRetain
MQTT:willRetain rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain MQTT:Connect ;
                rdfs:range xsd:boolean ;
                rdfs:comment "The Will Retain flag of a CONNECT packet: whether the Will Message is published as a retained message when the Network Connection is closed abnormally (3.1.2.7)." ;
                rdfs:label "will retain"@en ;
                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1.2.7"@en .


#################################################################
#    Classes
#################################################################

###  http://www.w3id.org/hsu-aut/MQTT#ApplicationMessage
MQTT:ApplicationMessage rdf:type owl:Class ;
                        rdfs:comment "The data carried by the MQTT protocol for the application, containing payload, QoS, properties, and topic name." ;
                        rdfs:label "application message"@en ;
                        dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Auth
MQTT:Auth rdf:type owl:Class ;
          rdfs:subClassOf MQTT:MQTTControlPacket ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty MQTT:hasReasonCode ;
                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass MQTT:ReasonCode
                          ] ;
          rdfs:comment "Authentication exchange control packet." ;
          rdfs:label "AUTH packet"@en ;
          dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.15"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Connack
MQTT:Connack rdf:type owl:Class ;
             rdfs:subClassOf MQTT:MQTTControlPacket ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty MQTT:hasReasonCode ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass MQTT:ReasonCode
                             ] ;
             rdfs:comment "Connect acknowledgment control packet sent from server to client." ;
             rdfs:label "CONNACK packet"@en ;
             dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Connect
MQTT:Connect rdf:type owl:Class ;
             rdfs:subClassOf MQTT:MQTTControlPacket ;
             rdfs:comment "Connection request control packet sent from client to server." ;
             rdfs:label "CONNECT packet"@en ;
             dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#DisallowedUnicodeCodePoint
MQTT:DisallowedUnicodeCodePoint rdf:type owl:Class ;
                                rdfs:comment "One of the Unicode Control Codes or Unicode Noncharacters which should not be included in a UTF-8 Encoded String (1.2, 1.5.4)." ;
                                rdfs:label "disallowed Unicode code point"@en ;
                                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 1.5.4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Disconnect
MQTT:Disconnect rdf:type owl:Class ;
                rdfs:subClassOf MQTT:MQTTControlPacket ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MQTT:hasReasonCode ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass MQTT:ReasonCode
                                ] ;
                rdfs:comment "Disconnect notification control packet." ;
                rdfs:label "DISCONNECT packet"@en ;
                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.14"@en .


###  http://www.w3id.org/hsu-aut/MQTT#FixedHeader
MQTT:FixedHeader rdf:type owl:Class ;
                 rdfs:comment "Fixed header present in all MQTT control packets containing packet type, flags, and remaining length." ;
                 rdfs:label "fixed header"@en ;
                 dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.1.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#MalformedPacket
MQTT:MalformedPacket rdf:type owl:Class ;
                     rdfs:subClassOf MQTT:MQTTControlPacket ;
                     rdfs:seeAlso MQTT:ReasonCodeMalformedPacket ;
                     rdfs:comment "A control packet that cannot be parsed according to the specification (1.2). Refer to 4.13.1 for error handling." ;
                     rdfs:label "malformed packet"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 4.13.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#MQTTClient
MQTT:MQTTClient rdf:type owl:Class ;
                owl:hasKey ( MQTT:clientId ) ;
                rdfs:comment "A program or device that uses MQTT to publish and/or subscribe to messages (1.2). Each Client connecting to a Server has a unique ClientID (3.1.3.1)." ;
                rdfs:label "MQTT client"@en ;
                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#MQTTConnection
MQTT:MQTTConnection rdf:type owl:Class ;
                    rdfs:comment "Network connection between an MQTT client and server providing ordered, lossless, bidirectional communication." ;
                    rdfs:label "network connection"@en ;
                    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 4.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#MQTTControlPacket
MQTT:MQTTControlPacket rdf:type owl:Class ;
                       rdfs:comment "Base class for all MQTT control packets exchanged between client and server." ;
                       rdfs:label "MQTT control packet"@en ;
                       dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 2.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#MQTTProperty
MQTT:MQTTProperty rdf:type owl:Class ;
                  rdfs:comment "The set of Properties of a control packet. 2.2.2: 'The last field in the Variable Header [...] is a set of Properties', composed of a Property Length followed by the Properties. Carries those Properties of Tab. 2-4 that belong to the packet exchange itself: authentication method and data, maximum packet size, receive maximum, topic alias maximum, reason string, server reference and the user properties." ;
                  rdfs:label "MQTT property"@en ;
                  dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.2.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#MQTTServer
MQTT:MQTTServer rdf:type owl:Class ;
                rdfs:comment "A program or device that acts as an intermediary between MQTT clients for message routing." ;
                rdfs:label "MQTT server"@en ;
                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#MQTTSession
MQTT:MQTTSession rdf:type owl:Class ;
                 rdfs:comment "Stateful interaction between a client and server that can span multiple network connections." ;
                 rdfs:label "MQTT session"@en ;
                 dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 4.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#PayloadFormat
MQTT:PayloadFormat rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( MQTT:PayloadFormatUnspecifiedBytes
                                                     MQTT:PayloadFormatUTF8
                                                   )
                                       ] ;
                   rdfs:comment "The format of the payload data of an Application Message: either unspecified bytes or UTF-8 Encoded Character Data (3.3.2.3.2)." ;
                   rdfs:label "payload format"@en ;
                   dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.2.3.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Payload
MQTT:Payload rdf:type owl:Class ;
             rdfs:comment "The payload section of an MQTT control packet containing packet-specific data." ;
             rdfs:label "payload"@en ;
             dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Pingreq
MQTT:Pingreq rdf:type owl:Class ;
             rdfs:subClassOf MQTT:MQTTControlPacket ;
             rdfs:comment "PING request control packet sent to test connectivity." ;
             rdfs:label "PINGREQ packet"@en ;
             dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.12"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Pingresp
MQTT:Pingresp rdf:type owl:Class ;
              rdfs:subClassOf MQTT:MQTTControlPacket ;
              rdfs:comment "PING response control packet." ;
              rdfs:label "PINGRESP packet"@en ;
              dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.13"@en .


###  http://www.w3id.org/hsu-aut/MQTT#ProtocolError
MQTT:ProtocolError rdf:type owl:Class ;
                   rdfs:seeAlso MQTT:ReasonCodeProtocolError ;
                   rdfs:comment "An error detected after a packet has been parsed, where the data is not allowed by the protocol or is inconsistent with the state of the Client or Server (1.2). Refer to 4.13.1 for error handling." ;
                   rdfs:label "protocol error"@en ;
                   dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 4.13.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Puback
MQTT:Puback rdf:type owl:Class ;
            rdfs:subClassOf MQTT:MQTTControlPacket ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty MQTT:hasReasonCode ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass MQTT:ReasonCode
                            ] ;
            rdfs:comment "Publish acknowledgment control packet for QoS 1 messages." ;
            rdfs:label "PUBACK packet"@en ;
            dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Pubcomp
MQTT:Pubcomp rdf:type owl:Class ;
             rdfs:subClassOf MQTT:MQTTControlPacket ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty MQTT:hasReasonCode ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass MQTT:ReasonCode
                             ] ;
             rdfs:comment "Publish complete control packet (QoS 2 delivery part 3)." ;
             rdfs:label "PUBCOMP packet"@en ;
             dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.7"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Publish
MQTT:Publish rdf:type owl:Class ;
             rdfs:subClassOf MQTT:MQTTControlPacket ;
             rdfs:comment "Publish message control packet for sending application messages." ;
             rdfs:label "PUBLISH packet"@en ;
             dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Pubrec
MQTT:Pubrec rdf:type owl:Class ;
            rdfs:subClassOf MQTT:MQTTControlPacket ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty MQTT:hasReasonCode ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass MQTT:ReasonCode
                            ] ;
            rdfs:comment "Publish received control packet (QoS 2 delivery part 1)." ;
            rdfs:label "PUBREC packet"@en ;
            dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.5"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Pubrel
MQTT:Pubrel rdf:type owl:Class ;
            rdfs:subClassOf MQTT:MQTTControlPacket ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty MQTT:hasReasonCode ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass MQTT:ReasonCode
                            ] ;
            rdfs:comment "Publish release control packet (QoS 2 delivery part 2)." ;
            rdfs:label "PUBREL packet"@en ;
            dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.6"@en .


###  http://www.w3id.org/hsu-aut/MQTT#QoS
MQTT:QoS rdf:type owl:Class ;
         owl:equivalentClass [ rdf:type owl:Class ;
                               owl:oneOf ( MQTT:QoS0
                                           MQTT:QoS1
                                           MQTT:QoS2
                                         )
                             ] ;
         rdfs:comment "The level of assurance for the delivery of an Application Message (4.3). Table 3-2 lists the three levels 0, 1 and 2; the fourth bit combination is reserved and must not be used." ;
         rdfs:label "quality of service"@en ;
         dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.1.2, 4.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#QoS0Publication
MQTT:QoS0Publication rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:intersectionOf ( MQTT:Publish
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty MQTT:hasApplicationMessage ;
                                                                  owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty MQTT:hasQoS ;
                                                                                       owl:hasValue MQTT:QoS0
                                                                                     ]
                                                                ]
                                                              )
                                         ] ;
                     rdfs:subClassOf MQTT:Publish ;
                     rdfs:comment "A PUBLISH packet whose Application Message is delivered with QoS 0, at most once delivery (4.3.1)." ;
                     rdfs:label "QoS 0 publication"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 4.3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#QoS1Publication
MQTT:QoS1Publication rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:intersectionOf ( MQTT:Publish
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty MQTT:hasApplicationMessage ;
                                                                  owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty MQTT:hasQoS ;
                                                                                       owl:hasValue MQTT:QoS1
                                                                                     ]
                                                                ]
                                                              )
                                         ] ;
                     rdfs:subClassOf MQTT:Publish ;
                     rdfs:comment "A PUBLISH packet whose Application Message is delivered with QoS 1, at least once delivery (4.3.2)." ;
                     rdfs:label "QoS 1 publication"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 4.3.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#QoS2Publication
MQTT:QoS2Publication rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:intersectionOf ( MQTT:Publish
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty MQTT:hasApplicationMessage ;
                                                                  owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty MQTT:hasQoS ;
                                                                                       owl:hasValue MQTT:QoS2
                                                                                     ]
                                                                ]
                                                              )
                                         ] ;
                     rdfs:subClassOf MQTT:Publish ;
                     rdfs:comment "A PUBLISH packet whose Application Message is delivered with QoS 2, exactly once delivery (4.3.3)." ;
                     rdfs:label "QoS 2 publication"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 4.3.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#ReasonCode
MQTT:ReasonCode rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf (
                                                      MQTT:ReasonCodeSuccess
                                                      MQTT:ReasonCodeNormalDisconnection
                                                      MQTT:ReasonCodeGrantedQoS0
                                                      MQTT:ReasonCodeGrantedQoS1
                                                      MQTT:ReasonCodeGrantedQoS2
                                                      MQTT:ReasonCodeDisconnectWithWillMessage
                                                      MQTT:ReasonCodeNoMatchingSubscribers
                                                      MQTT:ReasonCodeNoSubscriptionExisted
                                                      MQTT:ReasonCodeContinueAuthentication
                                                      MQTT:ReasonCodeReAuthenticate
                                                      MQTT:ReasonCodeUnspecifiedError
                                                      MQTT:ReasonCodeMalformedPacket
                                                      MQTT:ReasonCodeProtocolError
                                                      MQTT:ReasonCodeImplementationSpecificError
                                                      MQTT:ReasonCodeUnsupportedProtocolVersion
                                                      MQTT:ReasonCodeClientIdentifierNotValid
                                                      MQTT:ReasonCodeBadUserNameOrPassword
                                                      MQTT:ReasonCodeNotAuthorized
                                                      MQTT:ReasonCodeServerUnavailable
                                                      MQTT:ReasonCodeServerBusy
                                                      MQTT:ReasonCodeBanned
                                                      MQTT:ReasonCodeServerShuttingDown
                                                      MQTT:ReasonCodeBadAuthenticationMethod
                                                      MQTT:ReasonCodeKeepAliveTimeout
                                                      MQTT:ReasonCodeSessionTakenOver
                                                      MQTT:ReasonCodeTopicFilterInvalid
                                                      MQTT:ReasonCodeTopicNameInvalid
                                                      MQTT:ReasonCodePacketIdentifierInUse
                                                      MQTT:ReasonCodePacketIdentifierNotFound
                                                      MQTT:ReasonCodeReceiveMaximumExceeded
                                                      MQTT:ReasonCodeTopicAliasInvalid
                                                      MQTT:ReasonCodePacketTooLarge
                                                      MQTT:ReasonCodeMessageRateTooHigh
                                                      MQTT:ReasonCodeQuotaExceeded
                                                      MQTT:ReasonCodeAdministrativeAction
                                                      MQTT:ReasonCodePayloadFormatInvalid
                                                      MQTT:ReasonCodeRetainNotSupported
                                                      MQTT:ReasonCodeQoSNotSupported
                                                      MQTT:ReasonCodeUseAnotherServer
                                                      MQTT:ReasonCodeServerMoved
                                                      MQTT:ReasonCodeSharedSubscriptionsNotSupported
                                                      MQTT:ReasonCodeConnectionRateExceeded
                                                      MQTT:ReasonCodeMaximumConnectTime
                                                      MQTT:ReasonCodeSubscriptionIdentifiersNotSupported
                                                      MQTT:ReasonCodeWildcardSubscriptionsNotSupported
                                                )
                                    ] ;
                rdfs:comment "A one byte unsigned value that indicates the result of an operation (2.4). Table 2-6 lists 45 Reason Codes; the same value can stand for different ones in different packets, as 0x00 is Success, Normal disconnection and Granted QoS 0." ;
                rdfs:label "reason code"@en ;
                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4, Tab. 2-6"@en .


###  http://www.w3id.org/hsu-aut/MQTT#SuccessReasonCode
MQTT:SuccessReasonCode rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Class ;
                                             owl:intersectionOf ( MQTT:ReasonCode
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty MQTT:reasonCodeValue ;
                                                                    owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                         owl:onDatatype xsd:unsignedByte ;
                                                                                         owl:withRestrictions ( [ xsd:maxInclusive "127"^^xsd:unsignedByte ] )
                                                                                       ]
                                                                  ]
                                                                )
                                           ] ;
                       rdfs:comment "A Reason Code that indicates successful completion. 2.4: 'Reason Codes less than 0x80 indicate successful completion of an operation.'" ;
                       rdfs:label "success reason code"@en ;
                       dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#ErrorReasonCode
MQTT:ErrorReasonCode rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:intersectionOf ( MQTT:ReasonCode
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty MQTT:reasonCodeValue ;
                                                                  owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                       owl:onDatatype xsd:unsignedByte ;
                                                                                       owl:withRestrictions ( [ xsd:minInclusive "128"^^xsd:unsignedByte ] )
                                                                                     ]
                                                                ]
                                                              )
                                         ] ;
                     rdfs:comment "A Reason Code that indicates failure. 2.4: 'Reason Code values of 0x80 or greater indicate failure.'" ;
                     rdfs:label "error reason code"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#RetainHandling
MQTT:RetainHandling rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( MQTT:RetainHandling0
                                                      MQTT:RetainHandling1
                                                      MQTT:RetainHandling2
                                                    )
                                        ] ;
                    rdfs:comment "The Retain Handling option of a Subscription, which specifies whether retained messages are sent when the subscription is established (3.8.3.1). Three values are allowed; the value 3 is a Protocol Error." ;
                    rdfs:label "retain handling"@en ;
                    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.8.3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#RetainedMessage
MQTT:RetainedMessage rdf:type owl:Class ;
                     rdfs:subClassOf MQTT:ApplicationMessage ;
                     rdfs:comment "Application message that is retained by the server for future subscribers." ;
                     rdfs:label "retained message"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.1.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#SharedSubscription
MQTT:SharedSubscription rdf:type owl:Class ;
                        rdfs:subClassOf MQTT:Subscription ;
                        rdfs:comment "A Subscription that can be associated with more than one subscribing Session, so that a matching publication is sent to only one of them (1.2, 4.8.2). Its Topic Filter has the form $share/{ShareName}/{filter}." ;
                        rdfs:label "shared subscription"@en ;
                        dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 4.8.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Suback
MQTT:Suback rdf:type owl:Class ;
            rdfs:subClassOf MQTT:MQTTControlPacket ;
            rdfs:comment "Subscribe acknowledgment control packet." ;
            rdfs:label "SUBACK packet"@en ;
            dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.9"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Subscribe
MQTT:Subscribe rdf:type owl:Class ;
               rdfs:subClassOf MQTT:MQTTControlPacket ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty MQTT:hasRequestedTopicFilter ;
                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass MQTT:TopicFilter
                               ] ;
               rdfs:comment "Subscribe request control packet." ;
               rdfs:label "SUBSCRIBE packet"@en ;
               dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.8"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Subscription
MQTT:Subscription rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty MQTT:hasTopicFilter ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass MQTT:TopicFilter
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty MQTT:hasMaximumQoS ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass MQTT:QoS
                                  ] ;
                  rdfs:comment "A Subscription comprises a Topic Filter and a maximum QoS and is associated with a single Session; a Session can contain more than one Subscription, each with a different Topic Filter (1.2). A Shared Subscription can be associated with more than one Session (4.8.2)." ;
                  rdfs:label "subscription"@en ;
                  dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Topic
MQTT:Topic rdf:type owl:Class ;
           rdfs:comment "Label attached to application messages for routing by the server." ;
           rdfs:label "topic"@en ;
           dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 4.7"@en .


###  http://www.w3id.org/hsu-aut/MQTT#TopicFilter
MQTT:TopicFilter rdf:type owl:Class ;
                 rdfs:comment "Expression in a subscription indicating interest in topics, may contain wildcards." ;
                 rdfs:label "topic filter"@en ;
                 dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 4.7"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Unsuback
MQTT:Unsuback rdf:type owl:Class ;
              rdfs:subClassOf MQTT:MQTTControlPacket ;
              rdfs:comment "Unsubscribe acknowledgment control packet." ;
              rdfs:label "UNSUBACK packet"@en ;
              dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.11"@en .


###  http://www.w3id.org/hsu-aut/MQTT#Unsubscribe
MQTT:Unsubscribe rdf:type owl:Class ;
                 rdfs:subClassOf MQTT:MQTTControlPacket ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty MQTT:hasRevokedTopicFilter ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass MQTT:TopicFilter
                                 ] ;
                 rdfs:comment "Unsubscribe request control packet." ;
                 rdfs:label "UNSUBSCRIBE packet"@en ;
                 dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.10"@en .


###  http://www.w3id.org/hsu-aut/MQTT#UserProperty
MQTT:UserProperty rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty MQTT:propertyName ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty MQTT:propertyValue ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ;
                  rdfs:comment "A User Property of a control packet, carrying one name and one value. 2.2.2.2: 'Followed by a UTF-8 String Pair.' Its meaning and interpretation are known only to the application programs that send and receive it." ;
                  rdfs:label "user property"@en ;
                  dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.2.2.2, Tab. 2-4"@en .


###  http://www.w3id.org/hsu-aut/MQTT#VariableHeader
MQTT:VariableHeader rdf:type owl:Class ;
                    rdfs:comment "Variable header component containing packet-specific fields like packet identifier and properties." ;
                    rdfs:label "variable header"@en ;
                    dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#WildcardSubscription
MQTT:WildcardSubscription rdf:type owl:Class ;
                          rdfs:subClassOf MQTT:Subscription ;
                          rdfs:comment "Subscription with a topic filter containing wildcard characters." ;
                          rdfs:label "wildcard subscription"@en ;
                          dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 4.7.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#WillMessage
MQTT:WillMessage rdf:type owl:Class ;
                 rdfs:subClassOf MQTT:ApplicationMessage ;
                 rdfs:comment "Message published by the server when a client disconnects abnormally." ;
                 rdfs:label "will message"@en ;
                 dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 1.2, 3.1.3.2"@en .


#################################################################
#    Individuals
#################################################################

###  http://www.w3id.org/hsu-aut/MQTT#PayloadFormatUnspecifiedBytes
MQTT:PayloadFormatUnspecifiedBytes rdf:type owl:NamedIndividual ,
                                            MQTT:PayloadFormat ;
                                   MQTT:payloadFormatValue "0"^^xsd:unsignedByte ;
                                   rdfs:comment "Payload Format 0: 'the Payload is unspecified bytes, which is equivalent to not sending a Payload Format Indicator' (3.3.2.3.2)." ;
                                   rdfs:label "unspecified bytes"@en ;
                                   dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.2.3.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#PayloadFormatUTF8
MQTT:PayloadFormatUTF8 rdf:type owl:NamedIndividual ,
                                MQTT:PayloadFormat ;
                       MQTT:payloadFormatValue "1"^^xsd:unsignedByte ;
                       rdfs:comment "Payload Format 1: 'the Payload is UTF-8 Encoded Character Data' (3.3.2.3.2). A receiver may validate it and answer with Reason Code 0x99 (Payload format invalid) if it does not match (4.13)." ;
                       rdfs:label "UTF-8 encoded character data"@en ;
                       dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.3.2.3.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#QoS0
MQTT:QoS0 rdf:type owl:NamedIndividual ,
                   MQTT:QoS ;
          MQTT:qosLevel "0"^^xsd:unsignedByte ;
          rdfs:comment "QoS 0, at most once delivery: the message is delivered according to the capabilities of the underlying network, no response is sent by the receiver and no retry is performed by the sender (4.3.1)." ;
          rdfs:label "QoS 0"@en ;
          dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 4.3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#QoS1
MQTT:QoS1 rdf:type owl:NamedIndividual ,
                   MQTT:QoS ;
          MQTT:qosLevel "1"^^xsd:unsignedByte ;
          rdfs:comment "QoS 1, at least once delivery: the message is acknowledged, and the sender retransmits until it is acknowledged, so the message arrives at least once (4.3.2)." ;
          rdfs:label "QoS 1"@en ;
          dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 4.3.2"@en .


###  http://www.w3id.org/hsu-aut/MQTT#QoS2
MQTT:QoS2 rdf:type owl:NamedIndividual ,
                   MQTT:QoS ;
          MQTT:qosLevel "2"^^xsd:unsignedByte ;
          rdfs:comment "QoS 2, exactly once delivery: the four-part handshake of PUBLISH, PUBREC, PUBREL and PUBCOMP ensures that the message arrives exactly once (4.3.3)." ;
          rdfs:label "QoS 2"@en ;
          dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 4.3.3"@en .


###  http://www.w3id.org/hsu-aut/MQTT#RetainHandling0
MQTT:RetainHandling0 rdf:type owl:NamedIndividual ,
                              MQTT:RetainHandling ;
                     MQTT:retainHandlingValue "0"^^xsd:unsignedByte ;
                     rdfs:comment "Send retained messages at the time of the subscribe (3.8.3.1)." ;
                     rdfs:label "retain handling 0"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.8.3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#RetainHandling1
MQTT:RetainHandling1 rdf:type owl:NamedIndividual ,
                              MQTT:RetainHandling ;
                     MQTT:retainHandlingValue "1"^^xsd:unsignedByte ;
                     rdfs:comment "Send retained messages at subscribe only if the subscription does not currently exist (3.8.3.1)." ;
                     rdfs:label "retain handling 1"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.8.3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#RetainHandling2
MQTT:RetainHandling2 rdf:type owl:NamedIndividual ,
                              MQTT:RetainHandling ;
                     MQTT:retainHandlingValue "2"^^xsd:unsignedByte ;
                     rdfs:comment "Do not send retained messages at the time of the subscribe (3.8.3.1)." ;
                     rdfs:label "retain handling 2"@en ;
                     dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 3.8.3.1"@en .


###  http://www.w3id.org/hsu-aut/MQTT#ReasonCodeSuccess
MQTT:ReasonCodeSuccess rdf:type owl:NamedIndividual ,
                                MQTT:ReasonCode ;
                       MQTT:reasonCodeValue "0"^^xsd:unsignedByte ;
                       MQTT:appliesToPacket MQTT:Connack ;
                       MQTT:appliesToPacket MQTT:Puback ;
                       MQTT:appliesToPacket MQTT:Pubrec ;
