                                      rdfs:comment "Reason Code 0x9F (Connection rate exceeded), indicates failure. Allowed in: CONNACK, DISCONNECT (2.4, Table 2-6)." ;
                                      rdfs:label "Connection rate exceeded"@en ;
                                      dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4, Tab. 2-6"@en .


