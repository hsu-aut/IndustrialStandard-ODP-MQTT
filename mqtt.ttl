                               rdfs:comment "Reason Code 0x9B (QoS not supported), indicates failure. Allowed in: CONNACK, DISCONNECT (2.4, Table 2-6)." ;
                               rdfs:label "QoS not supported"@en ;
                               dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4, Tab. 2-6"@en .


###  http://www.w3id.org/hsu-aut/MQTT#ReasonCodeUseAnotherServer
MQTT:ReasonCodeUseAnotherServer rdf:type owl:NamedIndividual ,
                                         MQTT:ReasonCode ;
                                MQTT:reasonCodeValue "156"^^xsd:unsignedByte ;
                                MQTT:appliesToPacket MQTT:Connack ;
                                MQTT:appliesToPacket MQTT:Disconnect ;
                                rdfs:comment "Reason Code 0x9C (Use another server), indicates failure. Allowed in: CONNACK, DISCONNECT (2.4, Table 2-6)." ;
                                rdfs:label "Use another server"@en ;
                                dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4, Tab. 2-6"@en .


###  http://www.w3id.org/hsu-aut/MQTT#ReasonCodeServerMoved
MQTT:ReasonCodeServerMoved rdf:type owl:NamedIndividual ,
                                    MQTT:ReasonCode ;
                           MQTT:reasonCodeValue "157"^^xsd:unsignedByte ;
                           MQTT:appliesToPacket MQTT:Connack ;
                           MQTT:appliesToPacket MQTT:Disconnect ;
                           rdfs:comment "Reason Code 0x9D (Server moved), indicates failure. Allowed in: CONNACK, DISCONNECT (2.4, Table 2-6)." ;
                           rdfs:label "Server moved"@en ;
                           dcterms:source "MQTT Version 5.0, OASIS Standard, 07 March 2019, 2.4, Tab. 2-6"@en .


