#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( MQTT:Auth
                MQTT:Connack
                MQTT:Connect
                MQTT:Disconnect
                MQTT:Pingreq
                MQTT:Pingresp
                MQTT:Puback
                MQTT:Pubcomp
                MQTT:Publish
                MQTT:Pubrec
                MQTT:Pubrel
                MQTT:Suback
                MQTT:Subscribe
                MQTT:Unsuback
                MQTT:Unsubscribe
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( MQTT:QoS0Publication
                MQTT:QoS1Publication
                MQTT:QoS2Publication
              )
] .


# The two payload formats are pairwise different.
[ rdf:type owl:AllDifferent ;
  owl:members ( MQTT:PayloadFormatUnspecifiedBytes
                MQTT:PayloadFormatUTF8
              )
] .


# The three QoS levels are pairwise different.
[ rdf:type owl:AllDifferent ;
  owl:members ( MQTT:QoS0
                MQTT:QoS1
                MQTT:QoS2
              )
] .


# 1.2: "A Subscription is associated with a single Session." The axiom is
# restricted to subscriptions that are not shared, because the same clause
# and 4.8.2 allow a Shared Subscription to be associated with more than one
# Session. Stated over the inverse of hasSubscription, whose domain is the
# session side.
[ rdf:type owl:Class ;
  owl:intersectionOf ( MQTT:Subscription
                       [ rdf:type owl:Class ;
                         owl:complementOf MQTT:SharedSubscription
                       ]
                     )
] rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty [ owl:inverseOf MQTT:hasSubscription ] ;
                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                    owl:onClass MQTT:MQTTSession
                  ] .


# The three retain handling values are pairwise different.
[ rdf:type owl:AllDifferent ;
  owl:members ( MQTT:RetainHandling0
                MQTT:RetainHandling1
                MQTT:RetainHandling2
              )
] .


# The 45 reason codes of Table 2-6 are pairwise different; three of them carry
# the same value 0x00.
[ rdf:type owl:AllDifferent ;
  owl:members (
                MQTT:ReasonCodeSuccess
                MQTT:ReasonCodeNormalDisconnection
                MQTT:ReasonCodeGrantedQoS0
                MQTT:ReasonCodeGrantedQoS1
                MQTT:ReasonCodeGrantedQoS2
                MQTT:ReasonCodeDisconnectWithWillMessage
                MQTT:ReasonCodeNoMatchingSubscribers
                MQTT:ReasonCodeNoSubscriptionExisted
                MQTT:ReasonCodeContinueAuthentication
                MQTT:ReasonCodeReAuthenticate
                MQTT:ReasonCodeUnspecifiedError
                MQTT:ReasonCodeMalformedPacket
                MQTT:ReasonCodeProtocolError
                MQTT:ReasonCodeImplementationSpecificError
                MQTT:ReasonCodeUnsupportedProtocolVersion
                MQTT:ReasonCodeClientIdentifierNotValid
                MQTT:ReasonCodeBadUserNameOrPassword
                MQTT:ReasonCodeNotAuthorized
                MQTT:ReasonCodeServerUnavailable
                MQTT:ReasonCodeServerBusy
                MQTT:ReasonCodeBanned
                MQTT:ReasonCodeServerShuttingDown
                MQTT:ReasonCodeBadAuthenticationMethod
                MQTT:ReasonCodeKeepAliveTimeout
                MQTT:ReasonCodeSessionTakenOver
                MQTT:ReasonCodeTopicFilterInvalid
                MQTT:ReasonCodeTopicNameInvalid
                MQTT:ReasonCodePacketIdentifierInUse
                MQTT:ReasonCodePacketIdentifierNotFound
                MQTT:ReasonCodeReceiveMaximumExceeded
                MQTT:ReasonCodeTopicAliasInvalid
                MQTT:ReasonCodePacketTooLarge
                MQTT:ReasonCodeMessageRateTooHigh
                MQTT:ReasonCodeQuotaExceeded
                MQTT:ReasonCodeAdministrativeAction
                MQTT:ReasonCodePayloadFormatInvalid
                MQTT:ReasonCodeRetainNotSupported
                MQTT:ReasonCodeQoSNotSupported
                MQTT:ReasonCodeUseAnotherServer
                MQTT:ReasonCodeServerMoved
                MQTT:ReasonCodeSharedSubscriptionsNotSupported
                MQTT:ReasonCodeConnectionRateExceeded
                MQTT:ReasonCodeMaximumConnectTime
                MQTT:ReasonCodeSubscriptionIdentifiersNotSupported
                MQTT:ReasonCodeWildcardSubscriptionsNotSupported
              )
] .


#################################################################
#    Payload per packet type -- 2.3, Table 2-5
#################################################################
# "Some MQTT Control Packets contain a Payload as the final part of the packet.
# In the PUBLISH packet this is the Application Message" (2.3). Table 2-5
# states per packet type whether a Payload is Required, Optional or None:
#   Required (CONNECT, SUBSCRIBE, SUBACK, UNSUBSCRIBE, UNSUBACK) -> min 1
#   Optional (PUBLISH)                                           -> nothing
#   None (the remaining nine)                                    -> max 0

MQTT:Connect rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Subscribe rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Suback rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Unsubscribe rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Unsuback rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Connack rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Puback rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Pubrec rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Pubrel rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Pubcomp rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Pingreq rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Pingresp rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Disconnect rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .

MQTT:Auth rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty MQTT:hasPayload ;
                      owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                      owl:onClass MQTT:Payload
                    ] .


#################################################################
#    Packet type values -- 2.1.2, Table 2-1
#################################################################
# The four-bit value that identifies a packet type on the wire. Value 0 is
# Reserved and Forbidden in Table 2-1 and has no class here.

MQTT:Connect MQTT:packetTypeValue "1"^^xsd:unsignedByte .
MQTT:Connack MQTT:packetTypeValue "2"^^xsd:unsignedByte .
MQTT:Publish MQTT:packetTypeValue "3"^^xsd:unsignedByte .
MQTT:Puback MQTT:packetTypeValue "4"^^xsd:unsignedByte .
MQTT:Pubrec MQTT:packetTypeValue "5"^^xsd:unsignedByte .
MQTT:Pubrel MQTT:packetTypeValue "6"^^xsd:unsignedByte .
MQTT:Pubcomp MQTT:packetTypeValue "7"^^xsd:unsignedByte .
MQTT:Subscribe MQTT:packetTypeValue "8"^^xsd:unsignedByte .
MQTT:Suback MQTT:packetTypeValue "9"^^xsd:unsignedByte .
MQTT:Unsubscribe MQTT:packetTypeValue "10"^^xsd:unsignedByte .
MQTT:Unsuback MQTT:packetTypeValue "11"^^xsd:unsignedByte .
MQTT:Pingreq MQTT:packetTypeValue "12"^^xsd:unsignedByte .
MQTT:Pingresp MQTT:packetTypeValue "13"^^xsd:unsignedByte .
MQTT:Disconnect MQTT:packetTypeValue "14"^^xsd:unsignedByte .
MQTT:Auth MQTT:packetTypeValue "15"^^xsd:unsignedByte .
